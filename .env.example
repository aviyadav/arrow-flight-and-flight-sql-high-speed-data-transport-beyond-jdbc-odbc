# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=flight_demo
PGUSER=flight_user
PGPASSWORD=password
PGSCHEMA=flight_demo

# Arrow Flight server
FLIGHT_HOST=0.0.0.0
FLIGHT_PORT=8815
FLIGHT_TLS=false
FLIGHT_CERT_PATH=certs/server.crt
FLIGHT_KEY_PATH=certs/server.key
FLIGHT_CA_PATH=certs/ca.pem
FLIGHT_AUTH_TOKEN=demo-secret-token

# RustFS / S3-compatible object storage
RUSTFS_ENDPOINT=http://localhost:9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=arrow-flight-demo
RUSTFS_REGION=us-east-1

# Data generation
DATA_DIR=data
BATCH_SIZE=50000
